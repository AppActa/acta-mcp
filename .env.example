ACTA_ENV=development
ACTA_HOST=0.0.0.0
PORT=8000
ACTA_LOG_LEVEL=INFO

# api_key em produção; disabled apenas em desenvolvimento/testes locais.
ACTA_OBSERVABILITY_ENABLED=false
ACTA_OBSERVABILITY_IN_TESTS=false
OTEL_SERVICE_NAME=acta-mcp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=acta
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.honeycomb.io/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://api.honeycomb.io/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-honeycomb-team=sua_honeycomb_api_key
OTEL_EXPORTER_OTLP_METRICS_HEADERS=x-honeycomb-team=sua_honeycomb_api_key,x-honeycomb-dataset=acta_metrics

ACTA_AUTH_MODE=api_key
ACTA_MCP_API_KEY=troque-por-um-segredo-forte
ACTA_DEFAULT_USUARIO_ID=1
ACTA_DEFAULT_EMPRESA_ID=1

DATABASE_URL=postgresql://acta:acta@localhost:5433/acta
ACTA_POSTGRES_POOL_MIN_SIZE=1
ACTA_POSTGRES_POOL_MAX_SIZE=10
ACTA_POSTGRES_TIMEOUT_SECONDS=10

MONGODB_URI=mongodb://localhost:27018
MONGODB_DATABASE=acta
ACTA_MONGO_TIMEOUT_MS=5000

QDRANT_API_KEY=sua_qdrant_api_key
QDRANT_CLUSTER_ENDPOINT=https://seu-cluster.cloud.qdrant.io
QDRANT_COLLECTION_NAME=acta_faq
QDRANT_MEMORY_COLLECTION_NAME=acta_memoria
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT_SECONDS=15

# Memória: mensagens expiram automaticamente; memórias explícitas persistem até
# o usuário excluí-las, salvo quando ele define uma retenção no consentimento.
ACTA_MEMORY_MESSAGE_RETENTION_DAYS=90
ACTA_MEMORY_INFERRED_RETENTION_DAYS=90
ACTA_MEMORY_SUMMARY_EVERY_MESSAGES=10
ACTA_MEMORY_RECENT_MESSAGES=8
